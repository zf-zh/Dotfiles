{
    // Basic
    "editor.fontSize": 16,
    "editor.acceptSuggestionOnEnter": "off",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.indentSize": "tabSize",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "workbench.editor.empty.hint": "hidden",
    "workbench.editor.enablePreview": false,
    "workbench.panel.defaultLocation": "right",
    "workbench.colorTheme": "Light Modern",
    "workbench.preferredLightColorTheme": "Light Modern",
    "workbench.preferredDarkColorTheme": "Dark Modern",
    "workbench.colorCustomizations": {
        "terminalCursor.foreground": "#7F7F7F"
    },
    "window.autoDetectColorScheme": true,
    "window.titleBarStyle": "native",
    "security.workspace.trust.untrustedFiles": "open",
    "update.mode": "none",
    // Terminal
    "terminal.integrated.profiles.linux": {
        "bash": {
            "path": "bash",
            "icon": "terminal-bash"
        },
        "zsh": {
            "path": "zsh"
        },
        "fish": {
            "path": "fish"
        },
        "tmux": {
            "path": "tmux",
            "icon": "terminal-tmux"
        },
        "pwsh": {
            "path": "pwsh",
            "icon": "terminal-powershell"
        },
        "bash-login": {
            "path": "bash",
            "args": [
                "-l"
            ],
            "icon": "terminal-bash"
        }
    },
    "terminal.integrated.defaultProfile.linux": "bash-login",
    "terminal.integrated.fontSize": 16,
    "terminal.integrated.tabs.enabled": false,
    "terminal.integrated.suggest.enabled": false,
    "terminal.integrated.initialHint": false,
    // Markdown
    "markdown-preview-enhanced.chromePath": "/opt/google/chrome/google-chrome",
    "[markdown]": {
        "editor.tabSize": 2,
        "editor.defaultFormatter": "yzhang.markdown-all-in-one",
        "files.trimTrailingWhitespace": false
    },
    // C++
    "C_Cpp.formatting": "clangFormat",
    "C_Cpp.clang_format_style": "file",
    "C_Cpp.clang_format_fallbackStyle": "Google",
    "[c][cpp]": {
        "editor.tabSize": 2,
        "editor.defaultFormatter": "ms-vscode.cpptools"
    },
    // Swift
    "swift.disableSwiftPackageManagerIntegration": true,
    "[swift]": {
        "editor.tabSize": 2,
        "editor.defaultFormatter": "swiftlang.swift-vscode"
    },
    // Python
    "[python]": {
        "editor.tabSize": 4,
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.organizeImports.ruff": "explicit"
        }
    },
    // Verilog
    "verilog.linting.linter": "iverilog",
    "verilog.linting.iverilog.arguments": "-i -g2012 -Wall",
    "verilog.ctags.enabled": true,
    "verilog.ctags.path": "/usr/bin/ctags",
    "verilog.formatting.verilogHDL.formatter": "verible-verilog-format",
    "verilog.formatting.systemVerilog.formatter": "verible-verilog-format",
    "verilog.formatting.veribleVerilogFormatter.path": "/usr/local/bin/verible-verilog-format",
    "verilog.formatting.veribleVerilogFormatter.arguments": "--indentation_spaces 2 --column_limit 100 --assignment_statement_alignment=align --port_declarations_alignment=align",
    "verilog.languageServer.veribleVerilogLs.enabled": true,
    "verilog.languageServer.veribleVerilogLs.path": "/usr/local/bin/verible-verilog-ls",
    "[verilog][systemverilog]": {
        "editor.tabSize": 2,
        "editor.defaultFormatter": "mshr-h.veriloghdl"
    },
    // LaTeX
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-pdf",
                "%DOCFILE%"
            ]
        },
        {
            "name": "xelatex",
            "command": "xelatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "%DOCFILE%"
            ]
        },
        {
            "name": "pdflatex",
            "command": "pdflatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "%DOCFILE%"
            ]
        },
        {
            "name": "bibtex",
            "command": "bibtex",
            "args": [
                "%DOCFILE%"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "xelatex",
            "tools": [
                "xelatex"
            ]
        },
        {
            "name": "pdflatex",
            "tools": [
                "pdflatex"
            ]
        },
        {
            "name": "latexmk",
            "tools": [
                "latexmk"
            ]
        },
        {
            "name": "xelatex -> bibtex -> xelatex*2",
            "tools": [
                "xelatex",
                "bibtex",
                "xelatex",
                "xelatex"
            ]
        },
        {
            "name": "pdflatex -> bibtex -> pdflatex*2",
            "tools": [
                "pdflatex",
                "bibtex",
                "pdflatex",
                "pdflatex"
            ]
        }
    ],
    "latex-workshop.view.pdf.viewer": "tab",
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.latex.autoClean.run": "onBuilt",
    "latex-workshop.latex.clean.subfolder.enabled": true,
    "latex-workshop.latex.recipe.default": "lastUsed",
    "latex-workshop.message.error.show": true,
    "latex-workshop.message.warning.show": true,
    "latex-workshop.formatting.latex": "latexindent",
    "latex-workshop.formatting.latexindent.path": "/opt/texlive/2026/bin/x86_64-linux/latexindent",
    "[latex]": {
        "editor.tabSize": 2,
        "editor.defaultFormatter": "James-Yu.latex-workshop",
        "editor.wordWrap": "on",
        "editor.wrappingIndent": "same"
    },
    "[tex][bibtex]": {
        "editor.tabSize": 2
    },
    // Qt
    "qt-core.qtInstallationRoot": "/opt/Qt",
    "qt-core.additionalQtPaths": [
        "/opt/Qt/6.11.0/gcc_64/bin/qtpaths6",
        {
            "name": "Qt-6.11.0-linux-g++_from_PATH",
            "path": "/opt/Qt/6.11.0/gcc_64/bin/qtpaths"
        }
    ],
    // Others
    "explorer.confirmPasteNative": false,
    "chat.viewSessions.orientation": "stacked",
    "git.openRepositoryInParentFolders": "never",
    "github.copilot.nextEditSuggestions.enabled": true,
    "github.copilot.nextEditSuggestions.eagerness": "high",
    "github.copilot.enable": {
        "markdown": true,
        "plaintext": true
    },
    "claudeCode.preferredLocation": "sidebar",
    "workbench.editorAssociations": {
        "*.copilotmd": "vscode.markdown.preview.editor",
        "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.qrc": "default",
        "*.qrc": "qt-core.qrcEditor"
    },
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*"
    }
}

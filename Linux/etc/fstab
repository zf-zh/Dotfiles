# /etc/fstab: static file system information.
#
# Use 'blkid' to print the universally unique identifier for a
# device; this may be used with UUID= as a more robust way to name devices
# that works even if disks are added and removed. See fstab(5).
#
# <file system> <mount point>   <type>  <options>       <dump>  <pass>
# / was on /dev/nvme0n1p9 during curtin installation
/dev/disk/by-uuid/19bf22b9-557c-4fcb-bc33-23e590efe76c / ext4 defaults,relatime 0 1
# /boot was on /dev/nvme0n1p8 during curtin installation
/dev/disk/by-uuid/8deb5d82-52e2-4215-a78b-3f236622775d /boot ext4 defaults 0 1
# /boot/efi was on /dev/nvme0n1p1 during curtin installation
/dev/disk/by-uuid/6417-7EFE /boot/efi vfat defaults 0 1
/swap.img	none	swap	sw	0	0
#
# Data Disk
/dev/disk/by-uuid/6250185050182CF3 /media/jz2024/Data ntfs defaults,relatime 0 0
#
# /opt
/dev/disk/by-uuid/fcb094f8-cb43-4a58-9a88-3894909449f6 /opt ext4 defaults,relatime 0 2
